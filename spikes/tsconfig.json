{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "node",
      "chrome"
    ],
    "noEmit": true
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "**/dist",
    "node_modules"
  ]
}