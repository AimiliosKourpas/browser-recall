{
  "name": "browser-recall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first local search for your browsing memory. Chrome MV3, no backend, no telemetry.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "wxt prepare",
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:built": "vitest run --config vitest.built.config.ts",
    "size": "size-limit",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:eval && npm run build && npm run test:built && npm run size",
    "test:eval": "vitest run --config vitest.eval.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "build:e2e": "BR_E2E=1 wxt build"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "preact": "^10.27.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@size-limit/file": "^11.2.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "axe-core": "^4.10.0",
    "eslint": "^9.0.0",
    "fast-check": "^4.10.2",
    "linkedom": "^0.18.13",
    "size-limit": "^11.2.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0",
    "wxt": "^0.20.0"
  },
  "size-limit": [
    {
      "name": "all extension JS (gzip)",
      "path": ".output/chrome-mv3/**/*.js",
      "gzip": true,
      "limit": "160 kB"
    },
    {
      "name": "all extension files incl. sqlite3.wasm (gzip)",
      "path": ".output/chrome-mv3/**/*",
      "gzip": true,
      "limit": "620 kB"
    }
  ]
}
